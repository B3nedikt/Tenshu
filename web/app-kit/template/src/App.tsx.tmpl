import { useTranslation } from 'react-i18next'
import { ErrorBoundary } from './components/ErrorBoundary'
import { RuntimeBanner } from './components/RuntimeBanner'

// __NAME__ on the web. No backend of its own: every view reads and writes through the apex bridge
// (`lib/proxy.ts`). Generated by scripts/new-web-app.sh — replace the placeholder with the app.
export default function App() {
  const { t } = useTranslation()

  return (
    // No headline and no width cap: the apex top bar names the app, and the frame is the app's to
    // fill. Once there are several sections, render them through `AppLayout` from
    // '@tenshu/app-kit/ui' (web-apps-layout.md §3.1).
    <div className="flex h-dvh flex-col bg-surface">
      <main className="flex min-h-0 flex-1 flex-col overflow-y-auto px-4 py-4 min-[900px]:px-7 min-[900px]:py-5">
        {/* First: in a tab without the runtime, every other read fails too. */}
        <RuntimeBanner />

        {/* Key it by the current view once there are several, so a crashed view recovers on
            navigation and the shell stays usable. */}
        <ErrorBoundary>
          <p className="text-sm text-text-2">{t('app.empty')}</p>
        </ErrorBoundary>
      </main>
    </div>
  )
}
