// __NAME__ — everything the apex knows about it: origin, gateway allowlist, route, Apps-section
// entry (web-app-suite.md F4). Generated by scripts/new-web-app.sh; adding this file IS the
// registration (`registry/index.ts` globs `apps/*.ts`).
import type { ProxyMethodAllowlist } from '@tenshu/sdk/bridge'
import { appOrigin, SESSION_METHODS, V1_INSTALL_AT_MS, type HostedApp } from '../types'

declare global {
  interface ImportMetaEnv {
    /** The __NAME__ app's origin (see `apps/registry/apps/__ID__.ts`). */
    readonly __ENV__?: string
  }
}

// ⚠⚠ F5 — exactly the methods `web/__ID__` calls: its `ProxyMethod` table in
// `web/__ID__/src/lib/proxy.ts` (`gatewayPermissions.test.ts` fails on drift either way). Exact
// names only; a `.*` prefix only for a namespace this app owns outright, and never a bare `'*'`.
// Starts with the session methods alone: the app can reach the runtime lease and nothing else.
const METHODS: ProxyMethodAllowlist = [
  ...SESSION_METHODS,
]

const PROD_ORIGIN = 'https://__ID__.tenshu.app'

export const __VAR__: HostedApp = {
  id: '__ID__',
  order: __ORDER__,
  title: '__NAME__',
  prodOrigin: PROD_ORIGIN,
  envName: '__ENV__',
  devPort: __PORT__,
  origin: () => appOrigin(import.meta.env.__ENV__, PROD_ORIGIN, __PORT__),
  methods: METHODS,
  routePath: '__ID__/*',
  // ⚠ DISPLAY data for the Apps section — what the app can actually call is `methods` above.
  manifest: {
    id: '__ID__',
    label: '__NAME__',
    description: '__NAME__, end-to-end encrypted.',
    version: '0.1.0',
    installedAtMs: V1_INSTALL_AT_MS,
    launchPath: '/__ID__',
    // TODO(__ID__): the permissions and services the Apps section shows (IA §4).
    permissions: [],
    services: [],
  },
}

export default __VAR__
