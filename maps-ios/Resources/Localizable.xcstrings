{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ uses Tenshu Control to %@. Get Control from the App Store, then come back to %@." : {
      "comment" : "Set-up screen body when Control is not installed; %1$@ = app name, %2$@ = what the app uses Control for (an infinitive clause), %3$@ = app name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nutzt Tenshu Control, um %2$@. Hol dir Control im App Store und kehre dann zu %3$@ zurück."
          }
        }
      }
    },
    "%@ uses Tenshu Control to %@. Set it up on this iPhone to continue." : {
      "comment" : "Set-up screen body; %1$@ = app name, %2$@ = what the app uses Control for (an infinitive clause)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nutzt Tenshu Control, um %2$@. Richte es auf diesem iPhone ein, um fortzufahren."
          }
        }
      }
    },
    "Apple will see which places you open, and when. Applies in this app; you can turn it off in Settings." : {
      "comment" : "Basemap election privacy disclosure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple sieht, welche Orte du öffnest und wann. Gilt in dieser App; du kannst es in den Einstellungen ausschalten."
          }
        }
      }
    },
    "Can't reach Tenshu Control — %@ is showing what it already has." : {
