    "Places are yours. They stay on your devices, end-to-end encrypted." : {
      "comment" : "Maps: trust cue footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte gehören dir. Sie bleiben auf deinen Geräten, Ende-zu-Ende-verschlüsselt."
          }
        }
      }
    },
    "Privacy policy" : {
      "comment" : "Settings row that opens Tenshu's privacy policy in the browser (PrivacyPolicyLink, ios-release/Sources/PrivacyPolicy.swift)",
