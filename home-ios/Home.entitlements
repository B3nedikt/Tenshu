<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Home-on-iOS SIMULATOR Keychain + App-Group entitlements (route 1). Mirrors
    calendar-ios/Calendar.entitlements. An ad-hoc-signed sim build needs an
    `application-identifier` to have a Keychain at all, plus the SHARED `app.tenshu.shared` group
    (bare string — ad-hoc signing has no team) that Control writes the route-1 key material into
    (`RealmKeyMaterialBridge`, read via `TenshuSharedKeychainGroup`), and the App Group
    `group.app.tenshu.shared` so `HomeLocalRuntime` reads the SAME `objects` replica Control
    writes. A real device uses the Team-prefixed variant in Home.device.entitlements.

    ⚠ This app shipped with no entitlements at all while it was mock-backed: no Keychain, so the
    route-1 gate could never have seen provisioning.
  -->
  <key>application-identifier</key>
  <string>app.tenshu.home.ios</string>
  <key>keychain-access-groups</key>
  <array>
    <string>app.tenshu.home.ios</string>
    <string>app.tenshu.shared</string>
  </array>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.app.tenshu.shared</string>
  </array>
</dict>
</plist>
