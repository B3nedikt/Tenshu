    <string name="mia_settings_coming_soon">Coming soon</string>
    <string name="mia_settings_grants_title">What Mia can read</string>
    <!-- ⚠ Says "per app" plainly: grants are per SERVICE and there is no per-file control,
         so copy implying otherwise would promise what the system cannot enforce (MQ-D6). -->
    <string name="mia_settings_grants_body">Mia only reads what you allow, one app at a time. Turning something off here means Mia stops using it — it can't answer from it, and it will say so rather than pretending there is nothing there.</string>
    <!-- ⚠ MQ-D6: a grant needs a VERB, not just a noun. Reading your calendar and adding to
         it are two different permissions and a user will reasonably want the first alone. -->
    <string name="mia_settings_grants_write">Let Mia add events</string>
    <string name="mia_settings_grants_files">Files</string>
    <string name="mia_settings_grants_timeline">Timeline</string>
    <string name="mia_settings_grants_fitness">Workouts</string>
    <string name="mia_settings_grants_places">Places</string>
    <string name="mia_settings_grants_calendar">Calendar</string>
    <!-- IN-4: what a model said is IN the user's photos. ⚠ Its own line, not folded into
         "files": reading a filename and reading a model's opinion about the picture are
         different permissions, and the second is the one more likely to be refused. -->
    <string name="mia_settings_grants_labels">Photo contents</string>
    <string name="mia_settings_grants_visual_search">Photo search by appearance</string>
    <string name="mia_settings_grants_devices">Smart-home devices</string>
    <string name="mia_settings_grants_routines">Routines</string>
    <!-- AV-1: dictation, and why it may be missing. ⚠⚠ "Absent and says so" (IN-D11) — the mic is
         hidden where speech cannot be recognised on the device, and this line is the "says so". -->
    <string name="mia_settings_dictation_title">Speaking to Mia</string>
    <string name="mia_settings_dictation_on">Your words are turned into text on this device. Nothing is recorded and no audio is sent anywhere.</string>
    <string name="mia_settings_dictation_off">This device can't recognise speech without sending the audio away, so Mia has no microphone here. Typing works exactly the same.</string>
    <string name="mia_settings_voice_title">Voice identification</string>
    <string name="mia_settings_voice_body">Teach Mia your voice so the smart speaker knows who is talking.</string>
    <string name="mia_settings_assistant_title">Set as default assistant</string>
    <string name="mia_settings_assistant_body">On Android, Mia can be your system-wide assistant. On iOS, use the Action Button or “Hey Siri, ask Mia”.</string>
    <string name="mia_settings_assistant_open">Open assistant settings</string>
    <string name="mia_settings_assistant_active">Active</string>
    <string name="mia_settings_model_title">Model &amp; inference</string>
    <string name="mia_settings_model_body">Choose where Mia thinks — on this device, or on your Tenshu Hub.</string>
    <string name="mia_settings_skills_title">Skills</string>
    <string name="mia_settings_skills_body">Third-party voice skills arrive with the Tenshu Store.</string>
    <!-- The Control wall (ADR 0025 §Decision 1b / §Decision 8). -->
    <string name="mia_control_wall_title">Set up Tenshu Control</string>
    <string name="mia_control_not_set_up">Tenshu Control is installed but isn't set up on this device yet. Mia answers through Control — open it to start fresh or join your other devices, then come back.</string>
    <string name="mia_control_open_action">Open Control</string>
    <string name="mia_control_not_installed">Tenshu Control isn't installed on this device. Mia answers through Control, so there's nothing it can look up until it's installed.</string>
    <string name="mia_control_not_installed_unpublished">Tenshu Control isn't installed on this device, and it isn't in the store yet — Mia can't answer anything until it is.</string>
    <string name="mia_control_not_installed_other_channel">Tenshu Control isn't installed on this device. Install it the same way you installed Mia.</string>
    <string name="mia_control_get_action">Get Control</string>
