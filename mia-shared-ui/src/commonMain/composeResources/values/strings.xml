    <!-- Onboarding (§4, M5): a one-time skippable intro, never a gate on the product. -->
    <string name="mia_onboarding_welcome_title">Meet Mia</string>
    <string name="mia_onboarding_welcome_body">Your assistant for everything in your realm — find photos from your Drive, places from your Timeline, and control your home. Private by design: Mia works for you, not on your data.</string>
    <string name="mia_onboarding_assistant_title">Make Mia your assistant</string>
    <string name="mia_onboarding_assistant_body">On Android you can set Mia as your system-wide assistant — a long press on home opens Mia from anywhere.</string>
    <string name="mia_onboarding_done_title">All set</string>
    <string name="mia_onboarding_done_body">Ask Mia anything — and find voice identification, model settings and more in Settings.</string>
