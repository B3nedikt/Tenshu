<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Mia-on-iOS SIMULATOR Keychain + App-Group entitlements (route-1; mia-query-layer.md §19).
    Mirrors calendar-ios/Calendar.entitlements. An ad-hoc-signed sim build needs an
    `application-identifier` to have a Keychain at all, plus the SHARED `app.tenshu.shared` group
    (bare string — ad-hoc signing has no team) that Control writes the route-1 key material into
    (`RealmKeyMaterialBridge`, read via `TenshuSharedKeychainGroup`), and the App Group
    `group.app.tenshu.shared` so `MiaLocalRuntime` reads the SAME `objects` replica Control
    writes (in-process route 1). A real device uses the Team-prefixed variant in
    Mia.device.entitlements.

    ⚠ Mia shipped with NO entitlements while it was mock-backed. A shell with none has no
    Keychain, so the route-1 gate can never see provisioning and the app is permanently on the
    set-up screen (the timeline-ios finding, route-1 migration P3-2).
  -->
  <key>application-identifier</key>
  <string>app.tenshu.mia.ios</string>
  <key>keychain-access-groups</key>
  <array>
    <string>app.tenshu.mia.ios</string>
    <string>app.tenshu.shared</string>
  </array>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.app.tenshu.shared</string>
  </array>
</dict>
</plist>
