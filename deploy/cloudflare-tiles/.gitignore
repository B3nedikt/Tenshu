# Never commit secrets or local Terraform state.
# NOTE: git ignore-rules do NOT support trailing inline comments - a '#' only
# starts a comment at the start of a line. Keep every pattern on its own line.

# your real values (account id, zone id, possibly the API token)
terraform.tfvars
*.auto.tfvars
# downloaded provider binaries
.terraform/
# !! contains every resource attribute in plaintext
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# bytecode from running copy-tiles-from-digitalocean.py
__pycache__/

# NOTE: .terraform.lock.hcl is intentionally NOT ignored - commit it after the first
# `terraform init` so every apply resolves the same provider plugins/hashes (HashiCorp's
# recommended practice).
