# Never commit secrets or local Terraform state.
# NOTE: git ignore-rules do NOT support trailing inline comments - a '#' only
# starts a comment at the start of a line. Keep every pattern on its own line.

# your real values (API token, account id)
terraform.tfvars
*.auto.tfvars
# downloaded provider binaries
.terraform/
# local state: the zone id and every record — back it up, don't commit it
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# NOTE: .terraform.lock.hcl is intentionally NOT ignored - commit it after the first
# `terraform init` so every apply resolves the same provider plugins/hashes.
