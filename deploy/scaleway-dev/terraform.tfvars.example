# Copy to terraform.tfvars and fill in. ⭐ The five SECRETS do not go here: ./tf.sh reads the
# Scaleway key pair, the git token, the issuer seed and the Postgres password from the macOS
# Keychain (its header has the five commands). The file stays gitignored all the same.
#
# Walkthrough for every value: docs/how-to/deploy-dev-lab-scaleway.md §2.

# ---- account / auth ----
# ⚠⚠ A SEPARATE Project from production. Projects are free, and this is what stops a destroy
# aimed at the dev lab from ever reaching the real relay.
project_id = "00000000-0000-0000-0000-000000000000"

zone   = "fr-par-1"
region = "fr-par"

# ---- the box ----
instance_type       = "DEV1-M" # 3 vCPU / 4 GB, same as the live relay box
root_volume_size_gb = 30       # ⚠ six images extract here, not one
data_volume_size_gb = 40

# ---- the dev plane ----
# ⚠⚠ A separate registrable domain. main.tf refuses anything under tenshu.app at plan time.
dev_domain = "tenshu.xyz"
acme_email = "you@your-real-domain.example" # ⚠ NOT example.com — Let's Encrypt refuses it outright

# Terraform owns the three A records. ⚠ Requires the zone to be added at Scaleway
# (console → Domains and DNS → external domain) and the registrar's nameservers pointed there.
manage_dns = false # ⚠⚠ the zone is at CLOUDFLARE; true would create records in a Scaleway zone nobody queries

# Optional: pull prebuilt images from GHCR instead of shipping them over SSH.
ghcr_user  = ""
ghcr_token = ""

# PUBLIC half of the issuer seed. Empty on the very first apply; after that, copy it from
#   ssh root@<ip> '/opt/tenshu/compose logs commerce | grep -i "public key"'
# ⚠⚠ Leave it empty and every rebuild comes back with enforcement silently OFF.
entitlement_issuer_pubkey = ""

# ---- image tags ----
relay_image_tag    = "latest"
commerce_image_tag = "latest"
apex_image_tag     = "latest"

# ⭐ PUBLIC half of an SSH certificate authority the box will trust (optional, but it is how an
# AGENT gets in without anyone holding a long-lived key — see the runbook §3b).
#   ssh-keygen -t ed25519 -f ~/.ssh/tenshu-dev-ca -C "tenshu dev lab CA"
# ⚠⚠ The PRIVATE half never goes on the box, in a cloud session, or in this repo.
# ssh_ca_public_key = "ssh-ed25519 AAAA... tenshu dev lab CA"

# The read-only mail endpoint for sessions with no SSH (runbook §10) has no line here: its one
# value is a secret, `dev-mailpit-token` in the Keychain (tf.sh). It needs a DNS-only A record
# for mail.<dev_domain>.

# Stripe TEST mode (optional). Empty => the fake rail. The two SECRETS (sk_test_…, whsec_…) go in
# the Keychain — see tf.sh — and only the price map lives here.
# stripe_price_ids = "tenshu.drive.basic=price_xxx,tenshu.drive.premium=price_yyy"
