# Copy to terraform.tfvars (git-ignored) and fill in. Then:
#   export CLOUDFLARE_API_TOKEN=...   # rather than putting it in this file
#   terraform init && terraform apply
#
# ⚠ Unlike deploy/cloudflare-tiles there is no staged cutover: the hostname is new, so one apply
# creates the bucket and attaches the custom domain together.

# --- required ---------------------------------------------------------------

# Cloudflare account ID — not a secret. The same value deploy/cloudflare-tiles uses.
account_id = "0123456789abcdef0123456789abcdef"

# Zone ID of tenshu.app — `terraform -chdir=deploy/cloudflare-dns output -raw zone_id`.
zone_id = "0123456789abcdef0123456789abcdef"

# --- optional (sensible defaults) -------------------------------------------
# bucket_name    = "tenshu-models"
# location       = "weur"
# domain         = "models.service.tenshu.app"
# min_tls        = "1.2"
# enable_dev_url = false
