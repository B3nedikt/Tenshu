#cloud-config
# First-boot bootstrap for the Tenshu commerce-issuer droplet. Rendered by Terraform
# (templatefile) and handed to the droplet as user_data. Written for a fresh Ubuntu LTS box.
#
# What it does:
#   1. Install Docker Engine + compose plugin.
#   2. Add a swapfile (so a modest droplet can survive the RAM-hungry Gradle build).
#   3. Mount the attached block-storage volume at /mnt/commerce_data (Postgres data - A28 store).
#   4. Clone the repo at the pinned ref (for the compose + Caddy files), write the env + the
#      Postgres override, `docker compose up`.
#
# Separate trust boundary from the relay (commerce-billing-plane.md D1): this box holds the A29
# signing seed + email PII (A28). TLS is load-bearing - Caddy terminates it; nothing is served
# in clear text. deploy.env is 0600 (issuer seed + Stripe keys + db password).

package_update: true
package_upgrade: false

write_files:
  # Env consumed by commerce-service/docker-compose.yml + the Postgres override below.
  - path: /opt/tenshu/deploy.env
    permissions: "0600"
    content: |
      COMMERCE_DOMAIN=${commerce_domain}
      ACME_EMAIL=${acme_email}
      COMMERCE_IMAGE_TAG=${commerce_image_tag}
      COMMERCE_DEV_MODE=${dev_mode}
      ISSUER_ID=${issuer_id}
      ISSUER_SEED=${issuer_seed}
      SIGNING_KEY_ID=${signing_key_id}
      DATABASE_URL=${database_url}
      POSTGRES_PASSWORD=${database_password}
      REDEMPTION_CODES=${redemption_codes}
      TOKEN_TTL_HOURS=${token_ttl_hours}
      TOP_TIER_QUOTA_BYTES=${top_tier_quota_bytes}
      ADMIN_TOKEN=${admin_token}
      ADMIN_TOTP_SECRET=${admin_totp_secret}
      SMTP_HOST=${smtp_host}
      SMTP_PORT=${smtp_port}
      SMTP_FROM=${smtp_from}
      SMTP_FROM_NAME=${smtp_from_name}
      SMTP_USERNAME=${smtp_username}
      SMTP_PASSWORD=${smtp_password}
      SMTP_STARTTLS=${smtp_starttls}
      STRIPE_SECRET_KEY=${stripe_secret_key}
      STRIPE_WEBHOOK_SECRET=${stripe_webhook_secret}
      STRIPE_PRICE_IDS=${stripe_price_ids}

  # Compose override: the durable account store (A28). The committed
  # commerce-service/docker-compose.yml deliberately omits Postgres ("explicit deploy choice");
  # this module bundles a postgres:16 sidecar with its data on the attached block volume so the
  # deploy is one-command + self-contained. Point DATABASE_URL at an external managed DB instead
  # (via the `database_url` var) and this sidecar just goes unused.
  - path: /opt/tenshu/commerce.override.yml
    permissions: "0644"
    content: |
      services:
        commerce:
          depends_on:
            db:
              condition: service_healthy
        db:
          image: postgres:16
          restart: unless-stopped
          # ⚠⚠ Spelled out here, NOT inherited. commerce-service/docker-compose.yml
          # caps its own services with an `x-logging` anchor, but a YAML anchor does
          # NOT cross compose files - and `db` exists only in this override, so it
          # would keep Docker's unbounded json-file default. That default filled the
          # relay droplet's root disk on 2026-08-15 (9.1 GB of container logs); see
          # docs/proposals/drive-upload-stop-and-reclamation.md §4.6.
          logging:
            driver: json-file
            options:
              max-size: "50m"
              max-file: "5"
          environment:
            POSTGRES_DB: commerce
            POSTGRES_USER: commerce
            POSTGRES_PASSWORD: "$${POSTGRES_PASSWORD}"
          volumes:
            - /mnt/commerce_data/pgdata:/var/lib/postgresql/data
          networks:
            - commercenet
          healthcheck:
            test: ["CMD-SHELL", "pg_isready -U commerce -d commerce"]
            interval: 5s
            timeout: 5s
            retries: 30

  # Bootstrap script, invoked once by runcmd below. Kept as a file (not inline)
  # so its output lands in /var/log/tenshu-bootstrap.log for debugging.
  - path: /opt/tenshu/bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      exec > >(tee -a /var/log/tenshu-bootstrap.log) 2>&1
      echo "=== tenshu commerce bootstrap $(date -u) ==="

      # --- 1. swap (defensive: the multi-module Gradle build is RAM-hungry) ---
      if [ ! -f /swapfile ]; then
        echo "creating 4G swapfile"
        fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
        chmod 600 /swapfile
        mkswap /swapfile
        swapon /swapfile
        echo '/swapfile none swap sw 0 0' >> /etc/fstab
      fi

      # --- 2. Docker Engine + compose plugin ---
      if ! command -v docker >/dev/null 2>&1; then
        echo "installing docker"
        install -m 0755 -d /etc/apt/keyrings
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
          | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
        chmod a+r /etc/apt/keyrings/docker.gpg
        . /etc/os-release
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $${VERSION_CODENAME} stable" \
          > /etc/apt/sources.list.d/docker.list
        apt-get update -y
        apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
        systemctl enable --now docker
      fi

      # --- 3. mount the DO block-storage volume (durable: Postgres data) ---
      VOL_DEV="$(readlink -f /dev/disk/by-id/scsi-0DO_Volume_tenshu-commerce-data 2>/dev/null || true)"
      if [ -z "$${VOL_DEV}" ]; then
        # Fallback: first unmounted data disk that isn't the root device.
        VOL_DEV="$(lsblk -dpno NAME,TYPE | awk '$2=="disk"{print $1}' | grep -v -E 'vda|sda' | head -n1 || true)"
      fi
      mkdir -p /mnt/commerce_data
      if [ -n "$${VOL_DEV}" ]; then
        if ! blkid "$${VOL_DEV}" >/dev/null 2>&1; then
          echo "formatting $${VOL_DEV} ext4"
          mkfs.ext4 -F "$${VOL_DEV}"
        fi
        if ! mountpoint -q /mnt/commerce_data; then
          mount "$${VOL_DEV}" /mnt/commerce_data
        fi
        grep -q "/mnt/commerce_data" /etc/fstab || \
          echo "$${VOL_DEV} /mnt/commerce_data ext4 defaults,nofail,discard 0 2" >> /etc/fstab
      else
        echo "WARNING: no data volume found; Postgres data will live on the droplet root disk"
      fi
      # The postgres:16 entrypoint (root) chowns its data dir to the postgres uid on init, so we
      # only need the bind target to exist. Don't chmod 0777 - postgres rejects a too-open data dir.
      mkdir -p /mnt/commerce_data/pgdata

      # --- 4. clone repo at the pinned ref (compose + Caddy files) + bring the stack up ---
      CLONE_URL="${git_repo_url}"
      if [ -n "${git_token}" ]; then
        CLONE_URL="$(echo "${git_repo_url}" | sed -e "s#^https://#https://x-access-token:${git_token}@#")"
      fi
      if [ ! -d /opt/tenshu/repo/.git ]; then
        git clone "$${CLONE_URL}" /opt/tenshu/repo
      fi
      cd /opt/tenshu/repo
      git remote set-url origin "$${CLONE_URL}"
      git fetch --all --tags --prune
      git checkout "${git_ref}"
      git pull --ff-only origin "${git_ref}" || true

      # --- bring the stack up: pull a prebuilt image, or build on-box ---
      # commerce_image_tag set => pull ghcr.io/b3nedikt/tenshu-commerce:<tag> (fast, amd64, no
      # RAM-hungry on-box build). Empty => build the fat jar here on first boot (needs the bigger box).
      COMPOSE="docker compose -f commerce-service/docker-compose.yml -f /opt/tenshu/commerce.override.yml --env-file /opt/tenshu/deploy.env"
      if [ -n "${commerce_image_tag}" ]; then
        if [ -n "${ghcr_token}" ]; then
          echo "logging in to ghcr.io as ${ghcr_user}"
          echo "${ghcr_token}" | docker login ghcr.io -u "${ghcr_user}" --password-stdin
        fi
        echo "pulling prebuilt commerce image (tag ${commerce_image_tag})"
        $${COMPOSE} pull commerce
        $${COMPOSE} up -d
      else
        echo "building + starting commerce on-box (first build can take several minutes)"
        $${COMPOSE} up -d --build
      fi

      echo "--- issuer public key (set the relay's ENTITLEMENT_ISSUER_PUBKEY to this) ---"
      # The issuer logs its public key on boot; surface it here for convenience.
      sleep 5
      $${COMPOSE} logs commerce 2>/dev/null | grep -i "issuer public key" | tail -n1 || \
        echo "(not logged yet - run: $${COMPOSE} logs commerce | grep -i 'issuer public key')"
      echo "=== bootstrap done $(date -u) ==="

packages:
  - git
  - curl
  - ca-certificates
  - gnupg

runcmd:
  - ["bash", "/opt/tenshu/bootstrap.sh"]
