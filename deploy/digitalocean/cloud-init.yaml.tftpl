#cloud-config
# First-boot bootstrap for the Tenshu sync relay droplet. Rendered by Terraform
# (templatefile) and handed to the droplet as user_data. Idempotent enough to
# survive a re-run, but it's written for a fresh Ubuntu LTS box.
#
# What it does:
#   1. Install Docker Engine + compose plugin.
#   2. Add a swapfile (so a modest droplet can survive the RAM-hungry Gradle build).
#   3. Mount the attached block-storage volume at /mnt/relay_data (durable plane).
#   4. Clone the repo at the pinned ref, write the env files, `docker compose up`.
#
# House Rule #1 is untouched: nothing here decrypts user data; the relay stores
# ciphertext + public keys only.

package_update: true
package_upgrade: false

write_files:
  # Caddy + relay config consumed by docker-compose (see sync-relay-server/).
  # The domain/email drive Caddy's automatic HTTPS; CORS is the only relay knob
  # most deploys touch (the rest are safe prod defaults baked into compose).
  - path: /opt/tenshu/deploy.env
    permissions: "0644"
    content: |
      RELAY_DOMAIN=${relay_domain}
      ACME_EMAIL=${acme_email}
      CORS_ALLOWED_ORIGINS=${cors_allowed_origins}
      RELAY_IMAGE_TAG=${relay_image_tag}
      ENTITLEMENT_ENFORCE=${entitlement_enforce}
      ENTITLEMENT_ISSUER_PUBKEY=${entitlement_issuer_pubkey}
      ENTITLEMENT_ISSUER_KEY_ID=${entitlement_issuer_key_id}
      GENESIS_RATE_LIMIT_PER_HOUR=${genesis_rate_limit_per_hour}

  # Bootstrap script, invoked once by runcmd below. Kept as a file (not inline)
  # so its output lands in /var/log/tenshu-bootstrap.log for debugging.
  - path: /opt/tenshu/bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      exec > >(tee -a /var/log/tenshu-bootstrap.log) 2>&1
      echo "=== tenshu relay bootstrap $(date -u) ==="

      # --- 1. swap (defensive: the multi-module Gradle build is RAM-hungry) ---
      if [ ! -f /swapfile ]; then
        echo "creating 4G swapfile"
        fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
        chmod 600 /swapfile
        mkswap /swapfile
        swapon /swapfile
        echo '/swapfile none swap sw 0 0' >> /etc/fstab
      fi

      # --- 2. Docker Engine + compose plugin ---
      if ! command -v docker >/dev/null 2>&1; then
        echo "installing docker"
        install -m 0755 -d /etc/apt/keyrings
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
          | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
        chmod a+r /etc/apt/keyrings/docker.gpg
        . /etc/os-release
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $${VERSION_CODENAME} stable" \
          > /etc/apt/sources.list.d/docker.list
        apt-get update -y
        apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
        systemctl enable --now docker
      fi

      # --- 3. mount the DO block-storage volume (durable: SQLite DB + blobs) ---
      # DO attaches the volume by a stable by-id symlink. Find it, format only if
      # it has no filesystem yet (initial_filesystem_type=ext4 usually pre-formats),
      # then mount + persist in fstab.
      VOL_DEV="$(readlink -f /dev/disk/by-id/scsi-0DO_Volume_tenshu-relay-data 2>/dev/null || true)"
      if [ -z "$${VOL_DEV}" ]; then
        # Fallback: first unmounted data disk that isn't the root device.
        VOL_DEV="$(lsblk -dpno NAME,TYPE | awk '$2=="disk"{print $1}' | grep -v -E 'vda|sda' | head -n1 || true)"
      fi
      mkdir -p /mnt/relay_data
      if [ -n "$${VOL_DEV}" ]; then
        if ! blkid "$${VOL_DEV}" >/dev/null 2>&1; then
          echo "formatting $${VOL_DEV} ext4"
          mkfs.ext4 -F "$${VOL_DEV}"
        fi
        if ! mountpoint -q /mnt/relay_data; then
          mount "$${VOL_DEV}" /mnt/relay_data
        fi
        grep -q "/mnt/relay_data" /etc/fstab || \
          echo "$${VOL_DEV} /mnt/relay_data ext4 defaults,nofail,discard 0 2" >> /etc/fstab
      else
        echo "WARNING: no data volume found; relay state will live on the droplet root disk"
      fi
      # The relay container runs as a non-root uid; make the data dir writable.
      mkdir -p /mnt/relay_data/relay-blobs
      chmod -R 0777 /mnt/relay_data

      # --- 4. clone repo at the pinned ref + bring the stack up ---
      # Splice a read-only token into the HTTPS URL for a private repo. Empty
      # git_token => anonymous clone (works once the repo is public). git output
      # doesn't echo the URL, so the token doesn't hit the bootstrap log - but it
      # does live in this script + .git/config on the box (read-only single-repo
      # scope keeps that acceptable).
      CLONE_URL="${git_repo_url}"
      if [ -n "${git_token}" ]; then
        CLONE_URL="$(echo "${git_repo_url}" | sed -e "s#^https://#https://x-access-token:${git_token}@#")"
      fi
      if [ ! -d /opt/tenshu/repo/.git ]; then
        git clone "$${CLONE_URL}" /opt/tenshu/repo
      fi
      cd /opt/tenshu/repo
      git remote set-url origin "$${CLONE_URL}"
      git fetch --all --tags --prune
      git checkout "${git_ref}"
      git pull --ff-only origin "${git_ref}" || true

      # Symlink the compose dir's expected env file into place.
      ln -sf /opt/tenshu/deploy.env /opt/tenshu/repo/sync-relay-server/deploy.env

      # --- bring the stack up: pull a prebuilt image, or build on-box ---
      # relay_image_tag set => pull ghcr.io/b3nedikt/tenshu-relay:<tag> (fast, no
      # RAM-hungry on-box build, so the droplet can be tiny). Empty => build the
      # fat jar here on first boot (the zero-infra default; needs the bigger box).
      COMPOSE="docker compose -f sync-relay-server/docker-compose.yml --env-file /opt/tenshu/deploy.env"
      if [ -n "${relay_image_tag}" ]; then
        # Private GHCR package needs a one-time login; empty token => anonymous
        # pull (works once the package is public). Token isn't echoed.
        if [ -n "${ghcr_token}" ]; then
          echo "logging in to ghcr.io as ${ghcr_user}"
          echo "${ghcr_token}" | docker login ghcr.io -u "${ghcr_user}" --password-stdin
        fi
        echo "pulling prebuilt relay image (tag ${relay_image_tag})"
        $${COMPOSE} pull relay
        $${COMPOSE} up -d
      else
        echo "building + starting the relay on-box (first build can take several minutes)"
        $${COMPOSE} up -d --build
      fi
      echo "=== bootstrap done $(date -u) ==="

packages:
  - git
  - curl
  - ca-certificates
  - gnupg

runcmd:
  - ["bash", "/opt/tenshu/bootstrap.sh"]
