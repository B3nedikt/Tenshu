# ⚠⚠ HOSTNAMES: the live zone is flatter than it looks. The real names are `tenshu.app` (the apex
# itself), `relay.tenshu.app`, `commerce.service.tenshu.app` and `tiles.service.tenshu.app` — there
# is no `relay.service.` or `apex.service.`. An earlier version of this file invented `.service.`
# for all of them, which produces a `relay_url` that does not resolve and an apex that cannot reach
# its relay. Check against `doctl compute domain records list tenshu.app` before inventing a name.
#
# Copy to terraform.tfvars (git-ignored) and fill in. Then:
#   terraform init && terraform apply

# --- credentials ------------------------------------------------------------
# ⚠ ONE Scaleway API key pair (console > IAM > API keys), not DO's token + Spaces keys.
access_key = "SCWXXXXXXXXXXXXXXXXXX"
secret_key = "00000000-0000-0000-0000-000000000000"
# ⚠ Scaleway scopes every resource to a Project. console > Project settings > Project ID.
project_id = "00000000-0000-0000-0000-000000000000"

# --- placement --------------------------------------------------------------
zone   = "fr-par-1"
region = "fr-par"

# --- the box ----------------------------------------------------------------
instance_type = "DEV1-M"   # ≈ s-2vcpu-4gb. DEV1-S is smaller/cheaper.

# --- relay ------------------------------------------------------------------
domain = "relay.tenshu.app"   # ⚠ production. relay-scw.… was the migration name; a rebuild with it gets no cert for relay.tenshu.app
acme_email = "you@your-real-domain.example"   # ⚠ NOT example.com — Let's Encrypt refuses it outright

# ⚠ Leave manage_dns false: the zone is served by DigitalOcean, then Cloudflare — never Scaleway.
manage_dns = false

# Prebuilt image is far kinder than building on the box.
relay_image_tag = ""
ghcr_user       = ""
ghcr_token      = ""

# ⚠⚠ The repo is PRIVATE, and the box clones it even when pulling a prebuilt image (the compose
# file lives there). Copy this from the DigitalOcean deploy's terraform.tfvars.
git_token = ""

# ⚠⚠ VERIFY THE TAG EXISTS before pinning it. The DigitalOcean deploy pinned one that had since been
# deleted from GHCR and kept working only on its local Docker cache — the pull 404s on any rebuild,
# and GHCR reports a missing tag and an unreadable one identically ("not found").
#   curl -sH "Authorization: Bearer $(printf %s "$GHCR_PAT" | base64)" \
#        https://ghcr.io/v2/b3nedikt/tenshu-relay/tags/list

# ⚠⚠ ACCOUNT-CLOSURE RECLAMATION — PERMANENTLY DELETES a closed account's stored content once its
# grace window (30 d from the recorded closure time) has passed, on a record signed by commerce.
# Production runs it ON since 2026-10-24 (retention-quota-model.md §3.3); leaving this out on a
# rebuild turns it off. Pairs with commerce's account_closure_relay_url — both are needed to delete.
# account_closure_reclaim = "true"
