*.iml
.gradle
.idea
.vscode
.claude
.DS_Store
build
bin
captures
.externalNativeBuild
.cxx
.kotlin
local.properties
xcuserdata
.gradle-daemon-jvm

# Deploy secrets — env files for docker-compose deployments (relay / commerce / apex).
# Hold ISSUER_SEED, domains, ACME email, etc. — never commit.
deploy.env
**/deploy.env
apex.env
**/apex.env

# Design assets generated outside the repo (claude.ai/design handoffs).
# Tracked locally only; may graduate to a submodule / subrepo later. See
# docs/design/tenshu-icons/GENERATOR_NOTES.md for the platform constraints
# any regeneration round needs to honour.
docs/design/tenshu-icons/
# Timeline design handoff — local-only for now (see docs/proposals/timeline-app.md
# for the decisions distilled from it; the committed proposal is the durable record).
docs/design/timeline/
# Fit design handoff — same convention (see docs/proposals/fit-app.md).
docs/design/fit/
# Maps design handoff — same convention (see docs/proposals/maps-app.md).
docs/design/maps/

# Local backend plane state (scripts/local-commerce-stack.sh)
.tenshu-local/

# Gate history + logs (scripts/gate-run.sh). Machine-local by construction: a
# flake rate is a property of the box that produced it, so merging two
# maintainers' histories into one file would average away the only variable
# the entries in docs/tech-debt.md keep turning on (load). Export explicitly
# when a number is worth quoting in a doc.
.tenshu-gate/

# Local-only Vite configs and diagnostics (untracked by convention; see the header in each).
# A directory-level `git add` has swept one of these into a commit before — they carry absolute
# machine paths and a proxy that talks to the production relay.
web/**/vite.local-*.config.*
web/vite-devlog.mjs

# Model catalog build outputs — signed artefacts and multi-hundred-MB checkpoints.
# The MANIFEST (deploy/models/models.json) is tracked; what the signer produces from it is not.
deploy/models/build/

# Store screenshots — generated by scripts/store-screenshots.sh (docs/how-to/store-screenshots.md)
store/*/screenshots/

# fastlane (store listings, scripts/store-push.sh): its run artefacts and a local gem install.
# The assembled listing, screenshots and Preview.html live under build/store/deliver/ (ignored above).
fastlane/report.xml
fastlane/Preview.html
fastlane/README.md
fastlane/test_output/
.bundle/
vendor/bundle/
# The hosted web apps, staged for the apex image by deploy/build-apex-image.sh.
web/.apps-dist/
