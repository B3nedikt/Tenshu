      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werden separat geladen; jedes Modell zeigt seine Lizenz unter Einstellungen → Modelle"
          }
        }
      }
    },
    "End-to-end encrypted · Built on Tenshu" : {
      "comment" : "Timeline settings: about trust line",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ende-zu-Ende-verschlüsselt · Basiert auf Tenshu"
          }
        }
      }
    },
    "Fold this place into" : {
      "comment" : "Timeline merge sheet: list header",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesen Ort zusammenführen mit"
