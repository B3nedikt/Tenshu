    "Appearance" : {
      "comment" : "Timeline settings: section header",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darstellung"
          }
        }
      }
    },
    "Apple will see which places you open, and when. Applies in this app; you can turn it off in Settings." : {
      "comment" : "Basemap election privacy disclosure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple sieht, welche Orte du öffnest und wann. Gilt in dieser App; du kannst es in den Einstellungen ausschalten."
          }
        }
      }
    },
    "Both places keep their visits. Nothing is deleted — you can undo this later." : {
      "comment" : "Timeline merge sheet: footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Orte behalten ihre Aufenthalte. Nichts wird gelöscht – du kannst das später rückgängig machen."
          }
        }
      }
    },
    "Can't reach Tenshu Control — %@ is showing what it already has." : {
      "comment" : "Not-connected banner; %@ = app name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenshu Control ist nicht erreichbar – %@ zeigt, was bereits vorhanden ist."
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbrechen"
          }
        }
      }
    },
    "Capture the places you visit and the trips between them, in the background. Off by default — everything stays end-to-end encrypted on your own devices; no location ever reaches a server in the clear. Needs the “Always” location permission to record while the app is closed." : {
      "comment" : "Timeline settings: location capture footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse im Hintergrund die Orte, die du besuchst, und die Strecken dazwischen. Standardmäßig aus – alles bleibt Ende-zu-Ende-verschlüsselt auf deinen eigenen Geräten; kein Standort erreicht jemals im Klartext einen Server. Für die Aufzeichnung bei geschlossener App ist die Standortberechtigung „Immer“ nötig."
          }
        }
      }
    },
    "Choose the right place" : {
      "comment" : "Timeline choose-place: sheet title",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richtigen Ort wählen"
          }
        }
      }
    },
    "Connect" : {
      "comment" : "Title and button of the contact connect sheet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden"
          }
        }
      }
    },
