<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ themed icons honour ONLY the alpha channel, so every opaque pixel collapses
  to one tint. The band and day dots are additive fills on otherwise empty ground rather
  than contrasting colours over the body, so they still read after tinting and need no
  evenodd cutout. Same 84/4.125 group as the foreground; coordinates copied verbatim.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="432"
    android:viewportHeight="432">
    <group
        android:translateX="84"
        android:translateY="84"
        android:scaleX="4.125"
        android:scaleY="4.125">
        <!-- Binding stems -->
        <path
            android:pathData="M 22 11 L 22 19 M 42 11 L 42 19"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Body (rect 11,18 42x34 rx=4) -->
        <path
            android:pathData="M 15 18 L 49 18 A 4 4 0 0 1 53 22 L 53 48 A 4 4 0 0 1 49 52 L 15 52 A 4 4 0 0 1 11 48 L 11 22 A 4 4 0 0 1 15 18 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Header band -->
        <path
            android:pathData="M 11 22 A 4 4 0 0 1 15 18 L 49 18 A 4 4 0 0 1 53 22 L 53 28 L 11 28 Z"
            android:fillColor="#FFFFFF" />
        <!-- Day dots (r=2.6) -->
        <path
            android:pathData="M 18.4 36 a 2.6 2.6 0 1 0 5.2 0 a 2.6 2.6 0 1 0 -5.2 0 Z M 29.4 36 a 2.6 2.6 0 1 0 5.2 0 a 2.6 2.6 0 1 0 -5.2 0 Z M 40.4 36 a 2.6 2.6 0 1 0 5.2 0 a 2.6 2.6 0 1 0 -5.2 0 Z M 18.4 44 a 2.6 2.6 0 1 0 5.2 0 a 2.6 2.6 0 1 0 -5.2 0 Z M 29.4 44 a 2.6 2.6 0 1 0 5.2 0 a 2.6 2.6 0 1 0 -5.2 0 Z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
