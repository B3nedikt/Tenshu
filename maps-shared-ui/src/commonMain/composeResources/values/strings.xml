    <!--
      SK-1b (core-schema-skew-surface.md): a proxy that is answering and *refusing* on a schema
      version is not an unreachable one. These name the app that actually fixes it, which on
      Android and desktop is usually Control rather than the app the banner is in.
    -->
    <string name="maps_skew_update_control">Maps is newer than Tenshu Control on this device. Update Control to keep your places syncing.</string>
    <string name="maps_skew_update_this_app">Maps is older than Tenshu Control on this device. Update Maps to keep your places syncing.</string>
    <string name="maps_skew_update_both">Maps and Tenshu Control are from different versions. Update both to keep your places syncing.</string>
    <!--
      SK-3: the realm pull fence - this DEVICE is behind the others, not this app behind its
      proxy. Different words on purpose: nothing is broken or unreachable, the device has simply
      stopped receiving, and everything already on it still works.
    -->
    <string name="maps_fenced_update_control">Tenshu Control on this device is older than your other devices, so your places has stopped updating. Everything already here is safe.</string>
    <string name="maps_fenced_update_this_app">Maps on this device is older than your other devices, so your places has stopped updating. Everything already here is safe.</string>
    <string name="maps_fenced_update_both">This device is older than your other devices, so your places has stopped updating. Everything already here is safe.</string>
    <!-- No host published a RuntimeIdentity row: say what is true, name nothing. -->
    <string name="maps_fenced_update_unknown">This device is older than your other devices, so your places has stopped updating. Updating Tenshu on this device fixes it. Everything already here is safe.</string>
