    <string name="contacts_detail_missing_title">Contact not found</string>
    <string name="contacts_detail_missing_body">They may have been deleted on another device.</string>

    <string name="contacts_profile_title">You</string>
    <string name="contacts_profile_name_label">Your name</string>
    <string name="contacts_profile_name_supporting">This is the name people see when you invite them.</string>
    <string name="contacts_profile_name_unset">No name set</string>
    <string name="contacts_profile_edit_name">Edit name</string>
    <string name="contacts_profile_name_save">Save</string>
    <string name="contacts_profile_name_cancel">Cancel</string>
    <string name="contacts_profile_identity_title">Your identity</string>
    <string name="contacts_profile_identity_pending">Your identity code and invitation link are not available on this device yet.</string>

    <!--
      Invitations (D6). Bare invites only — Drive owns the share-a-folder ones, so nothing
      here mentions folders or sharing.
    -->
    <string name="contacts_invite_title">Invite someone</string>
    <string name="contacts_invite_intro">Create a one-time invitation. Whoever accepts it becomes one of your contacts — nothing is shared until you choose to share it.</string>
    <string name="contacts_invite_create">Invite someone</string>
    <string name="contacts_invite_creating">Creating…</string>
    <string name="contacts_invite_qr_description">Invitation QR code</string>
    <string name="contacts_invite_link_caption">Have them scan this, or send them the link.</string>
    <string name="contacts_invite_copy_link">Copy link</string>
