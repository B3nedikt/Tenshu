<?xml version="1.0" encoding="utf-8"?>
<!--
  Contacts' user-facing strings (ADR 0016: every user-facing string is authored via
  `stringResource(…)` from the first commit). Keys are prefixed `contacts_` so they stay
  greppable when the catalogue graduates to ICU JSON at n = 2.

  ⚠ Apostrophes are written bare ('), not escaped (\') — the CMP resource formatter does
  not decode escapes, so a \' renders literally.
-->
<resources>
    <string name="contacts_nav_contacts">Contacts</string>
    <string name="contacts_nav_you">You</string>

    <!--
      Reachability (fit-app.md §9.14). Names Control rather than "the network", because that
      is what is actually missing — and it is the difference between a blank list that looks
      like data loss and one that explains itself.
    -->
    <!-- Realm storage (drive-synced-folders.md §8b.5c). No plan is the silent state — nothing
         syncs from any app; full blocks new data only. Neither loses anything. -->
    <string name="contacts_storage_no_plan_text">Not syncing — this device has no storage plan, so your data stays on this device. Set up storage to sync across your devices.</string>
    <string name="contacts_storage_full_text">Storage full — %1$s of %2$s used. Your data stays on this device and nothing is deleted, but it can't sync until you free up space or get more.</string>
    <string name="contacts_storage_action">Manage storage</string>
    <string name="contacts_storage_setup_action">Set up storage</string>
    <string name="contacts_control_unreachable">Can't reach Tenshu Control. Your contacts will appear once it is running.</string>
    <string name="contacts_control_open_action">Open Control</string>
    <string name="contacts_control_not_installed">Tenshu Control isn't installed on this device. Your contacts live in Control, so there's nothing to show until it's installed.</string>
    <string name="contacts_control_wall_title">Set up Tenshu Control</string>
    <!-- ADR 0025 §Decision 8: Control installed and answering, no realm on this device. -->
    <string name="contacts_control_not_set_up">Tenshu Control is installed but isn't set up on this device yet. Your contacts live in Control — open it to start fresh or join your other devices, then come back.</string>
    <string name="contacts_control_not_installed_unpublished">Tenshu Control isn't installed on this device, and it isn't in the store yet — your contacts stay empty until it is.</string>
    <string name="contacts_control_not_installed_other_channel">Tenshu Control isn't installed on this device. Install it the same way you installed Contacts.</string>
    <string name="contacts_control_get_action">Get Control</string>
    <string name="contacts_update_action">Update</string>
    <!--
      SK-1b (core-schema-skew-surface.md): a proxy that is answering and *refusing* on a schema
      version is not an unreachable one. These name the app that actually fixes it, which on
      Android and desktop is usually Control rather than the app the banner is in.
    -->
    <string name="contacts_skew_update_control">Contacts is newer than Tenshu Control on this device. Update Control to keep your contacts syncing.</string>
    <string name="contacts_skew_update_this_app">Contacts is older than Tenshu Control on this device. Update Contacts to keep your contacts syncing.</string>
    <string name="contacts_skew_update_both">Contacts and Tenshu Control are from different versions. Update both to keep your contacts syncing.</string>
    <!--
      SK-3: the realm pull fence - this DEVICE is behind the others, not this app behind its
      proxy. Different words on purpose: nothing is broken or unreachable, the device has simply
      stopped receiving, and everything already on it still works.
    -->
    <string name="contacts_fenced_update_control">Tenshu Control on this device is older than your other devices, so your contacts has stopped updating. Everything already here is safe.</string>
    <string name="contacts_fenced_update_this_app">Contacts on this device is older than your other devices, so your contacts has stopped updating. Everything already here is safe.</string>
    <string name="contacts_fenced_update_both">This device is older than your other devices, so your contacts has stopped updating. Everything already here is safe.</string>
    <!-- No host published a RuntimeIdentity row: say what is true, name nothing. -->
    <string name="contacts_fenced_update_unknown">This device is older than your other devices, so your contacts has stopped updating. Updating Tenshu on this device fixes it. Everything already here is safe.</string>

    <!--
      The list has no title bar: it is the search bar's strip, Drive's shape. The nav item
      already says "Contacts", and spending a whole bar repeating it cost the search field
      its place.
    -->
    <string name="contacts_add_actions_description">Add a contact</string>
    <string name="contacts_list_empty_title">No contacts yet</string>
    <string name="contacts_list_empty_body">People you exchange an invitation with appear here, along with anyone you add yourself.</string>

    <string name="contacts_search_placeholder">Search your contacts</string>
    <string name="contacts_search_clear">Clear search</string>
    <string name="contacts_search_empty_title">No matches</string>

    <!--
      The four badge states (D3). `NeedsReverification` is the one that has to earn its
      words: it names the key change (Q2b), because "not verified" alone would read as
      though the user had simply never got round to it.
    -->
    <string name="contacts_trust_verified">Verified</string>
    <string name="contacts_trust_verified_detail">You compared this contact's code and confirmed it.</string>
    <string name="contacts_trust_unverified">Not verified</string>
    <string name="contacts_trust_unverified_detail">You have not compared this contact's code yet. Their messages still arrive; verifying confirms you are talking to the person you think you are.</string>
    <string name="contacts_trust_needs_reverification">Key changed</string>
    <string name="contacts_trust_needs_reverification_detail">This contact is using a key you have not verified. That happens after they reinstall or set up a new device — verify again to be sure it is still them.</string>
    <string name="contacts_trust_not_connected">Not connected</string>
    <string name="contacts_trust_not_connected_detail">You added this person yourself, so there is no key to verify.</string>

    <string name="contacts_detail_title">Contact</string>
    <string name="contacts_detail_keyring_title">Keys</string>
