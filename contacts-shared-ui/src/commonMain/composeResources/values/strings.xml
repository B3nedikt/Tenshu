    <string name="error_contacts_none_in_file">No contacts found in that file.</string>
    <string name="error_contacts_nothing_to_export">This contact has nothing to export.</string>
    <string name="error_contacts_photo_unavailable">This contact's photo is not on this device yet. Connect to the internet and try again.</string>
