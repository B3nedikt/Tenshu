    <!--
      The completion prompt. The header quotes their claimed name because that is what it
      is — a claim — and the SAS copy has to make clear that ticking the box is an
      assertion the user is making, not a box to clear.
    -->
    <string name="contacts_confirm_banner">"%1$s" accepted your invitation</string>
    <string name="contacts_confirm_banner_action">Tap to save them as a contact</string>
    <string name="contacts_confirm_header">"%1$s" accepted your invitation</string>
    <string name="contacts_confirm_unnamed">Someone</string>
    <string name="contacts_confirm_claim_note">That is the name they gave. Their key:</string>
    <string name="contacts_confirm_sas_note">Read these six digits to them — over a call, or in person. They see the same six on their side.</string>
    <string name="contacts_confirm_sas_check">The codes match</string>
    <string name="contacts_confirm_petname_label">Save them as</string>
    <string name="contacts_confirm_own_name_label">Your name</string>
    <string name="contacts_confirm_own_name_note">This is what they will see you as.</string>
    <string name="contacts_confirm_link_existing">Link to an existing contact</string>
    <string name="contacts_confirm_link_existing_none">You have no other contacts yet.</string>
    <string name="contacts_confirm_save">Save contact</string>
    <string name="contacts_confirm_decline">Decline</string>

    <!-- Contact CRUD (Ph4). -->
    <string name="contacts_name_label">Name</string>
    <string name="contacts_dialog_cancel">Cancel</string>
    <string name="contacts_add_title">Add a contact</string>
    <!-- D5: says plainly what a keyless contact is, so the missing badge is not a mystery. -->
    <string name="contacts_add_supporting">You can add someone without connecting to them. Exchange an invitation later to share with them.</string>
    <string name="contacts_add_confirm">Add</string>
    <string name="contacts_rename_title">Rename</string>
    <string name="contacts_rename_supporting">This name is yours — it is not shared with them.</string>
    <string name="contacts_rename_confirm">Save</string>
    <string name="contacts_delete_title">Delete contact</string>
    <string name="contacts_delete_body">This removes them and their keys from all your devices.</string>
    <!--
      ⚠⚠ Q7b. Deleting a contact revokes nothing — memberships are keyed by the member's
      A26 identity, not by personId — so someone deleting a contact to cut them off would
      otherwise get the exact opposite, silently. The copy cannot yet name the folders
      involved (see contacts-app.md §9.2), so it points at where they can be checked.
    -->
    <string name="contacts_delete_access_warning">This does not take away anything you have already shared with them. To stop their access to shared folders, remove them in Drive first.</string>
    <string name="contacts_delete_confirm">Delete</string>
    <string name="contacts_unlink_title">Remove key</string>
    <string name="contacts_unlink_body">Remove the key %1$s from this contact? They stay in your contacts, and you can connect again later.</string>
    <string name="contacts_unlink_confirm">Remove key</string>

    <!--
      Re-verification (Ph5, Q2a). ⚠ The copy has to make clear that tapping confirm is an
      assertion the user is making about a comparison they performed — not a box to clear.
    -->
    <string name="contacts_verify_action">Verify</string>
    <string name="contacts_unverify_action">Un-verify</string>
    <string name="contacts_verify_title">Compare your codes</string>
    <string name="contacts_verify_body">Read these six digits to them — over a call, or in person. They see the same six on their side. Only confirm if they match.</string>
    <string name="contacts_verify_loading">Getting the code…</string>
    <string name="contacts_verify_unavailable">The code is not available right now. Unlock this device and try again.</string>
    <string name="contacts_verify_confirm">They match</string>

    <!--
      User-assisted merge (Ph9, D7). ⚠⚠ Every string here has to read as a QUESTION. Nothing
      merges without an explicit confirmation, because everything a handshake delivers is
      self-asserted — a system that merged on a name match would let an attacker's key
      inherit a known person's contact card. The copy must not sound like a finding.
    -->
    <string name="contacts_merge_title">Possible duplicates</string>
    <string name="contacts_merge_banner">%1$d possible duplicates</string>
    <string name="contacts_merge_banner_action">Review and combine them</string>
    <string name="contacts_merge_pair">"%1$s" and "%2$s"</string>
    <string name="contacts_merge_reason_phone">Same phone number</string>
    <string name="contacts_merge_reason_email">Same email address</string>
    <string name="contacts_merge_reason_name">Same name</string>
    <!-- Two people genuinely can share a name, so a name-only match is not evidence. -->
    <string name="contacts_merge_name_only_note">— which two people can share.</string>
    <string name="contacts_merge_keep_label">Which one should be kept? The other is combined into it, and its name is the one you will see.</string>
    <!--
      ⚠ Said before the merge, not discovered after it: the rows that move carry no memory of
      where they came from, so there is genuinely nothing to undo with.
    -->
    <string name="contacts_merge_no_undo">Their keys, cards and photo all move across. This cannot be undone.</string>
    <string name="contacts_merge_confirm">Combine</string>
    <string name="contacts_merge_empty_title">No duplicates found</string>
    <string name="contacts_merge_empty_body">Nobody in your contacts looks like anyone else. Imported contacts are never combined for you — this is where they would show up if they were.</string>

    <!--
      Contact photos (Ph8). No confirmation dialog behind this: an imported card keeps its
      PHOTO, so removing it here is reversible by re-importing — which the copy says, since
      "remove" otherwise reads as destroying the picture.
    -->
    <string name="contacts_photo_remove">Remove photo</string>

