<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Calendar-on-iOS REAL-DEVICE entitlements (ios-signing.md §2) — sdk=iphoneos builds only; the
    simulator keeps Calendar.entitlements. No `application-identifier` (the profile injects it);
    Keychain groups are Team-prefixed via $(AppIdentifierPrefix); the App Group (below) is the
    shared-replica container and needs the paid company team (ios-signing.md §6); a device build
    that cannot resolve it refuses to open a store rather than run on an app-local one. The
    shared Keychain group is what `RealmKeyMaterialBridge` reads Control's route-1 key material from.
  -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)app.tenshu.calendar.ios</string>
    <string>$(AppIdentifierPrefix)app.tenshu.shared</string>
  </array>
  <!--
    The App Group: the ONE replica every first-party app reads and writes on a real device
    (ios-background-scheduling.md S0). Bare id, no team prefix: iOS App Group ids are global, and
    this string must equal the simulator file's and the Kotlin `TENSHU_APP_GROUP`.
  -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.app.tenshu.shared</string>
  </array>
</dict>
</plist>
