<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the tray agent's pure logic (desktop-windows-port.md §3.9 T3): the bridge-reply decoding, the
    display copy and the heartbeat format Control parses. The files are LINKED, not referenced: the agent is a WinUI
    executable, and these classes need none of it — so this project is plain net10.0 and runs on any OS.
    ⚠ Link only files free of WinUI and P/Invoke; anything else belongs in the agent and is checked on a device.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tenshu.TrayAgent.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TrayAgent\TrayState.cs" Link="Linked\TrayState.cs" />
    <Compile Include="..\TrayAgent\Strings.cs" Link="Linked\Strings.cs" />
    <Compile Include="..\TrayAgent\Heartbeat.cs" Link="Linked\Heartbeat.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
