<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Control's native Windows tray agent (docs/proposals/desktop-windows-port.md §3.9, D5): the twin of
    control-desktop/macos/TrayAgent. A second executable inside the Control MSIX, speaking the JSON bridge.

    ⚠ No .xaml files on purpose: the UI is built in code, so `dotnet publish` needs no XAML compiler step.
    ⚠⚠ The Windows App SDK is FRAMEWORK-DEPENDENT, not self-contained. Self-contained registers WinRT classes in
      this exe's own manifest, which Windows ignores once the process runs in a package context — and as a child
      of the packaged Control it always does: WinUI then died at startup (0xc000027b in Microsoft.UI.Xaml.dll,
      2026-11-10). Control's AppxManifest declares the Microsoft.WindowsAppRuntime.1.8 dependency instead (the
      Store installs it); a standalone dev run bootstraps it explicitly (Program.cs).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Tenshu.TrayAgent</RootNamespace>
    <AssemblyName>tray-agent</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Bootstrapped by hand, and only without package identity: in a package the graph already has it. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- PerMonitorV2 DPI awareness; without it the tray icon and menu were bitmap-stretched (see the file). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned: bump deliberately. A floating version makes builds unreproducible, and Control's manifest declares the
         matching runtime (tenshu.msix.windowsAppRuntime in control-desktop/build.gradle.kts). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cat: the very vector Android's themed icon uses — one source of truth, rendered at run time. -->
    <EmbeddedResource Include="..\..\..\control\src\main\res\drawable\ic_launcher_monochrome.xml" LogicalName="cat.xml" />
  </ItemGroup>

</Project>
