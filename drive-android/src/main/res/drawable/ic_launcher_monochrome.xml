<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ themed icons honour ONLY the alpha channel (docs/adr/0026-app-icon-system.md
  §5): every opaque pixel becomes the user's tint. Same geometry as the foreground,
  coordinates copied verbatim.

  ⚠ The inner <group> is the radius-30 fit: the mark is scaled about the grid centre so
  every rendered pixel stays inside radius 30 and no launcher mask clips it. Stroke
  widths are authored pre-scale, so they render at the set's 3.5 baseline.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="432"
    android:viewportHeight="432">
    <group
        android:translateX="84"
        android:translateY="84"
        android:scaleX="4.125"
        android:scaleY="4.125">
        <group
            android:translateX="3.84"
            android:translateY="3.84"
            android:scaleX="0.88"
            android:scaleY="0.88">
            <path
                android:pathData="M 8 22 L 8 50 a 4 4 0 0 0 4 4 L 52 54 a 4 4 0 0 0 4 -4 L 56 24 a 4 4 0 0 0 -4 -4 L 30 20 L 26 14 a 2 2 0 0 0 -2 -1 L 12 13 a 4 4 0 0 0 -4 4 z"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="3.9773"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                />
        </group>
    </group>
</vector>
