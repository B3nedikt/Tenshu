    <string name="fit_import_file_hint">Übernimm deinen Google-Fit-Verlauf aus einer Exportdatei</string>
    <string name="fit_sharing_title">Deine Trainings übernehmen</string>
    <string name="fit_sharing_row_title">Einstellungen zum Teilen prüfen</string>
    <string name="fit_sharing_row_hint">Sieh nach, was deine anderen Gesundheits-Apps am Teilen hindert</string>
    <string name="fit_sharing_notice_action">Beheben</string>
    <string name="fit_sharing_no_store_title">Health Connect ist auf diesem Gerät nicht vorhanden</string>
    <string name="fit_sharing_no_store_body">In Health Connect speichert Android Gesundheitsdaten, die Apps miteinander teilen können. Ohne Health Connect können deine anderen Apps nirgendwohin teilen, und hier gibt es nichts zu lesen. Du kannst trotzdem einen Google-Takeout-Export importieren.</string>
    <string name="fit_sharing_allow_reading_title">Dieser App das Lesen von Health Connect erlauben</string>
    <string name="fit_sharing_allow_reading_body">Es wird nichts gelesen, bis du es erlaubst. Deine Gesundheitsdaten bleiben auf deinen Geräten und sind Ende-zu-Ende-verschlüsselt.</string>
    <string name="fit_sharing_allow_reading_action">Erlauben</string>
    <string name="fit_sharing_allow_history_title">Ältere Daten einbeziehen</string>
    <string name="fit_sharing_allow_history_body">Health Connect teilt nur die letzten 30 Tage, es sei denn, du erlaubst den Zugriff auf ältere Daten.</string>
    <string name="fit_sharing_allow_history_action">Ältere Daten erlauben</string>
    <string name="fit_sharing_allow_fit_title">Google Fit das Teilen mit Health Connect erlauben</string>
    <string name="fit_sharing_allow_fit_body">Google Fit kann deine Trainings an Health Connect weitergeben, darf das aber noch nicht. Diese Berechtigung gehört zu Google Fit, daher schaltest du sie in Health Connect ein – wir prüfen das für dich, wenn du zurückkommst.</string>
    <string name="fit_sharing_allow_fit_action">Health Connect öffnen</string>
    <string name="fit_sharing_confirm_title">Google Fit ist jetzt erlaubt</string>
    <string name="fit_sharing_confirm_body">Google Fit darf mit Health Connect teilen. Es teilt nach eigenem Zeitplan, daher sind seine Trainings möglicherweise noch nicht da – prüfe jetzt oder warte ab, dann holen wir sie beim nächsten Import ab.</string>
    <string name="fit_sharing_confirm_action">Jetzt prüfen</string>
    <string name="fit_sharing_needs_export_title">Google Fit ist erlaubt, hat aber nichts geteilt</string>
    <string name="fit_sharing_needs_export_body">An den Berechtigungen liegt es nicht mehr, weiteres Erlauben hilft also nicht: Das Teilen umfasst neue Aktivitäten, nicht den Verlauf, der schon in Google Fit liegt. Über einen Google-Takeout-Export kommt dieser Verlauf hierher.</string>
    <string name="fit_sharing_needs_export_action">Aus Google Takeout importieren</string>
    <string name="fit_sharing_done_title">Alles ist eingerichtet</string>
    <string name="fit_sharing_done_body">Health Connect ist lesbar und nichts wird zurückgehalten. Neue Aktivitäten erscheinen hier, sobald deine Apps sie aufzeichnen.</string>
    <string name="fit_source_notice_google_fit_blocked_title">Google Fit teilt noch nicht mit Health Connect</string>
    <string name="fit_source_notice_google_fit_blocked_body">Google Fit kann deine Trainings an Health Connect weitergeben, darf das aber noch nicht – daher sind sie hier nicht sichtbar. Schalte es in Health Connect unter „App-Berechtigungen“ ein.</string>
    <string name="fit_source_notice_google_fit_blocked_action">Health Connect öffnen</string>
    <string name="fit_source_notice_google_fit_title">Google Fit darf teilen, hat aber nichts geteilt</string>
    <string name="fit_source_notice_google_fit_body">Google Fit darf in Health Connect schreiben, und trotzdem ist keines seiner Trainings dort – das Teilen umfasst neue Aktivitäten, nicht den Verlauf, der schon in der App liegt.</string>
    <string name="fit_source_notice_google_fit_action">Importiere einen Google-Takeout-Export, um diesen Verlauf zu übernehmen.</string>
    <string name="fit_import_full_history_title">Gesamten Verlauf importieren</string>
    <string name="fit_import_full_history_hint">Health Connect teilt nur die letzten 30 Tage, es sei denn, du erlaubst den Zugriff auf ältere Daten</string>
    <string name="fit_import_full_history_granted">Health Connect teilt auch deine älteren Daten</string>
    <string name="fit_onboarding_history_title">Ältere Daten übernehmen?</string>
    <string name="fit_onboarding_history_body">Health Connect teilt standardmäßig nur die letzten 30 Tage. Erlaube den Zugriff auf vergangene Daten, dann kann Fit alles lesen, was deine Apps und deine Uhr aufgezeichnet haben.</string>
    <string name="fit_onboarding_history_allow">Ältere Daten erlauben</string>
    <string name="fit_onboarding_history_skip">Nicht jetzt</string>
