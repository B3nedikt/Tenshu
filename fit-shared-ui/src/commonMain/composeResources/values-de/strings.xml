    <string name="fit_update_action">Aktualisieren</string>
    <string name="fit_skew_update_control">Fit ist neuer als Tenshu Control auf diesem Gerät. Aktualisiere Control, damit deine Gesundheitsdaten weiter synchronisiert werden.</string>
    <string name="fit_skew_update_this_app">Fit ist älter als Tenshu Control auf diesem Gerät. Aktualisiere Fit, damit deine Gesundheitsdaten weiter synchronisiert werden.</string>
    <string name="fit_skew_update_both">Fit und Tenshu Control stammen aus unterschiedlichen Versionen. Aktualisiere beide, damit deine Gesundheitsdaten weiter synchronisiert werden.</string>
    <string name="fit_fenced_update_control">Tenshu Control ist auf diesem Gerät älter als auf deinen anderen Geräten, daher kommen keine neuen Gesundheitsdaten mehr an. Alles, was bereits hier ist, bleibt erhalten.</string>
