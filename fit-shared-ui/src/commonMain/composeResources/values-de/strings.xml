    <string name="fit_import_no_data_title">Noch nichts zu importieren</string>
    <string name="fit_import_no_data_body">Health Connect hat keine Gesundheitsdaten zum Teilen. Google Fit sendet von sich aus keine Daten an Health Connect – öffne Google Fit und verbinde es oder importiere eine Datei.</string>
    <string name="fit_import_permission_title">Fit braucht die Berechtigung, deine Gesundheitsdaten zu lesen</string>
    <string name="fit_import_permission_body">Erteile Fit Lesezugriff in Health Connect und versuche den Import dann erneut.</string>
    <string name="fit_import_unavailable_title">Keine Gesundheitsquelle auf diesem Gerät</string>
    <string name="fit_import_unavailable_body">Health Connect ist hier nicht verfügbar. Du kannst trotzdem Trainings aufzeichnen oder eine Datei importieren.</string>
    <string name="fit_import_sample_title">Beispieldaten werden angezeigt</string>
    <string name="fit_import_sample_body">Diese Zahlen sind ein eingebautes Beispiel, nicht deine Gesundheitsdaten. Verbinde eine Quelle, um deine eigenen zu sehen.</string>
    <string name="fit_import_failed_title">Import fehlgeschlagen</string>
    <string name="fit_import_failed_body">Fit konnte deine Gesundheitsdaten nicht lesen. Versuche es erneut.</string>
    <string name="fit_import_waiting_title">Warten auf Tenshu Control</string>
    <string name="fit_import_waiting_body">Control ist noch nicht bereit, deine Gesundheitsdaten aufzubewahren, daher wurde nichts importiert. Öffne Control und versuche es dann erneut – derselbe Import wird ausgeführt.</string>
    <string name="fit_import_retry">Erneut versuchen</string>
