    <!-- Storage full. Names the figures because "storage full" is indistinguishable from a bug
         when the user believes they have space, and says nothing is deleted because that is the
         actual anxiety (P3 reclamation is INERT — nothing is being removed). -->
    <string name="sync_banner_storage_full_text">Storage full — %1$s of %2$s used. Your data stays on this device and nothing is deleted, but it can't sync until you free up space or get more.</string>
    <string name="sync_banner_storage_full_action">Manage storage</string>
    <string name="sync_banner_needs_attention_text">Storage needs attention on this device — your changes are saved here but can't sync yet. Sign in to sync on this device.</string>
    <!-- The relay holds no registration for this device (401): it was revoked, or the account's
         data was restored/reset behind it. Deliberately not phrased as "Offline", which would send
         the user to check their network.
         ⚠⚠ Does NOT name a cause. The relay refuses to say which of the two it is, and the earlier
         copy ("it has been removed from your account") asserted the one the client cannot know —
         wrong, and alarming, whenever the truth was a restored relay.
         ⚠⚠ Names the ROLE this device must take, because it cannot take the other one: an
         unrecognised device can neither host (`GET /sync/pairing/requests` is JWT-gated) nor
         approve (`/sync/pairing/offer-response` verifies against its *registered* A4 key). It must
         be the one showing a code for a healthy device to approve — which is exactly what
         `PairingWizardViewModel` switches the tab to on `deviceUnrecognized`, so this sentence
         describes what the user will actually see.
         ⚠⚠ Warns off "Forget this device" by name. It is the obvious-looking remedy when nothing
         works and it is the one action that makes this permanent: it clears DEVICE_ID while the
         self-revoke tombstone can never be pushed from a 401'd device, so the realm keeps an
         orphaned row and this device returns as a stranger. See docs/tech-debt.md → "A joiner that
         loses its relay registration is wedged permanently". -->
    <string name="sync_banner_device_unrecognized_text">This device isn't being accepted by your account, so nothing syncs here — your files on it are safe. Open Control and add this device again: it will show a code for one of your other devices to approve. Don't use Forget this device first — anything still waiting to upload would be lost.</string>
    <string name="sync_banner_device_unrecognized_action">Open Control</string>
    <string name="sync_banner_needs_update_text">Update needed — your other devices are using a newer version of Tenshu, so their latest changes aren't downloading here. Your files on this device are safe and still upload.</string>
    <string name="sync_banner_needs_app_update_control">Drive is newer than Tenshu Control on this device. Update Control to see your files again.</string>
    <string name="sync_banner_needs_app_update_this_app">Tenshu Control is newer than Drive on this device. Update Drive to see your files again.</string>
    <string name="sync_banner_needs_app_update_both">Drive and Tenshu Control disagree on a data version. Update both to see your files again.</string>
    <string name="sync_banner_needs_app_update_action">Update</string>
    <string name="sync_banner_disconnected_text">Can't reach Control — your files are safe on this device. Reconnecting…</string>
    <string name="sync_banner_offline_text">Offline — your changes are saved on this device and will sync when you reconnect.</string>
    <!-- %1$d = file being uploaded (1-based), %2$d = files in this pass, %3$s = bytes left.
         Replaces the old "Syncing your changes…", which said nothing the user could verify. -->
    <string name="sync_banner_uploading_text">Uploading %1$d of %2$d · %3$s left</string>
    <string name="sync_banner_uploading_retrying_text">Uploading %1$d of %2$d · server errors, retrying</string>
    <!-- %1$d = files waiting to upload. ⚠ POSITIONAL, not a bare %d: CMP's formatter leaves a bare
         specifier untouched, so the banner rendered a literal "%d" on device (2026-08-02).
